# MongoDB connection string. For local MongoDB:
#   mongodb://127.0.0.1:27017/stock-tracker
# For MongoDB Atlas (free tier), copy the connection string from your
# cluster's "Connect" dialog and put your database name at the end.
MONGODB_URI=mongodb://127.0.0.1:27017/stock-tracker

# Secret used to sign session tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Set to "production" when deploying. Leave unset for local development.
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# Only used in development, so the API accepts requests from the Vite dev
# server (which runs on a different port).
CLIENT_ORIGIN=http://localhost:5173

# Timezone used to decide which calendar day "today" is for stock entries
# and to date older records. Defaults to Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata

# Public URL of the app, used to build links in emails (password reset,
# email confirmation). Required in production for those emails to work.
APP_URL=http://localhost:5173

# --- Email (password reset, email confirmation, security notices) ---
# Sent over an HTTPS API — Render's free plan blocks SMTP. Leave
# EMAIL_PROVIDER empty to switch email features off (in development the
# messages are printed to the server console instead).
#   brevo:  https://app.brevo.com → SMTP & API → API keys; verify EMAIL_FROM
#           under Senders. Free plan: 300 emails/day.
#   resend: https://resend.com → API keys; needs a domain you own.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Warely

# --- Google sign-in ("Continue with Google") ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Add your site to "Authorized JavaScript origins"
# (e.g. https://warelyy.onrender.com and http://localhost:5173).
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Set to "true" to skip the Have I Been Pwned check on new passwords
# (e.g. when running offline). Leave unset in production.
# DISABLE_BREACH_CHECK=true
