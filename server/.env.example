# MongoDB connection string. For local MongoDB:
#   mongodb://127.0.0.1:27017/stock-tracker
# For MongoDB Atlas (free tier), copy the connection string from your
# cluster's "Connect" dialog and put your database name at the end.
MONGODB_URI=mongodb://127.0.0.1:27017/stock-tracker

# Secret used to sign session tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Set to "production" when deploying. Leave unset for local development.
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# Only used in development, so the API accepts requests from the Vite dev
# server (which runs on a different port).
CLIENT_ORIGIN=http://localhost:5173
